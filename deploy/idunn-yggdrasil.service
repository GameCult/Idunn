[Unit]
Description=Idunn deployment admission and daemon-survival authority
After=network-online.target docker.service
Wants=network-online.target
# Deployment runners use Docker, but continuity actuation does not. Warm,
# fence, promote, drain and restart all run on systemd; only the build step
# is containerized, and worktree-tree recipes skip even that. A hard
# Requires= would let a Docker outage stop Idunn itself, killing daemon
# survival for every target. Want it, order after it, and let individual
# container-backed deploys fail on their own if it is absent.
Wants=docker.service

[Service]
Type=simple
User=idunn
Group=idunn
# Idunn discovers no authority implicitly. Every store is named here, and
# every one of them is Idunn's own -- no path below belongs to a managed
# target. That is the invariant, expressed as a command line.
ExecStart=/usr/local/bin/idunn serve \
  --state-store /var/lib/gamecult/idunn/control.cc \
  --bindings-dir /etc/gamecult/idunn/bindings \
  --source-root /var/lib/gamecult/idunn/sources \
  --staging-root /var/lib/gamecult/idunn/staging \
  --topology-store /var/lib/gamecult/idunn/topology.cc \
  --idunn-identity-store /var/lib/gamecult/idunn/idunn-service-identity.cc \
  --odin-correlation-store /var/lib/gamecult/odin/idunn-runtime-topology.cc \
  --odin-trust-anchor /etc/gamecult/idunn/odin-topology-anchor.cc \
  --deployment-brake-operator-anchor /etc/gamecult/idunn/deployment-brake-operator-anchor.cc
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
UMask=027
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
# Idunn's own state, and the build root it materializes releases in.
# Enumerated rather than broadened: this list is the blast radius.
ReadWritePaths=/var/lib/gamecult/idunn /var/lib/gamecult/idunn-authority /srv/build
# Everything Idunn only reads. The operator anchor and target bindings are
# operator-authored: Idunn admits against them, it does not write them.
# /var/lib/gamecult/odin is a managed target's directory and is read-only on
# purpose -- Idunn consumes Odin's published topology correlation to gate
# *deployment* promotion, and nothing else. Continuity never consults it
# (see stale_odin_provider_receipt_cannot_gate_continuity_restart), and an
# absent store returns None rather than failing, so Odin being down blocks
# promotions and leaves daemon survival untouched.
ReadOnlyPaths=/etc/gamecult/idunn /var/lib/gamecult/odin

[Install]
WantedBy=multi-user.target
